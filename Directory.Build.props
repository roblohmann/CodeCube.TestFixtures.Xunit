<Project>

  <!-- Centrale package-metadata voor alle projecten in deze repository. Een csproj kan deze waarden overschrijven. -->
  <PropertyGroup>
    <Authors>Rob Lohmann</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/roblohmann/CodeCube.TestFixtures.Xunit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/roblohmann/CodeCube.TestFixtures.Xunit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <VersionPrefix>1.1.3</VersionPrefix>
  </PropertyGroup>

</Project>
